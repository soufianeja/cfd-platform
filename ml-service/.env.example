APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS - allow requests from the backend
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Where trained models are stored
MODEL_DIR=./models

# Authentication key for triggering retraining
TRAINING_API_KEY=your-secret-key-here

# Auto-retraining threshold — retrain when this many real validated rows exist
RETRAIN_THRESHOLD=50
